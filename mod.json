{
  "geode": "5.11.2",
  "version": "v1.0.0",
  "id": "davinxs.dlgen",
  "name": "DLGen",
  "developer": "davinxs",
  "description": "Generate randomized playable GD layouts.",
  "repository": "https://github.com/davineresmedeiros-dotcom/DLGen",
  "tags": [
    "editor",
    "utility"
  ],
  "settings": {
    "generator-title": {
      "type": "title",
      "name": "Layout Generator"
    },
    "difficulty": {
      "type": "string",
      "name": "Difficulty",
      "default": "Normal",
      "one-of": [
        "Easy",
        "Normal",
        "Hard",
        "Insane",
        "Demon"
      ]
    },
    "time": {
      "type": "string",
      "name": "Time",
      "default": "Medium",
      "one-of": [
        "Medium",
        "Long",
        "XL"
      ]
    },
    "orbs": {
      "type": "string",
      "name": "Orbs",
      "default": "Active",
      "one-of": [
        "Active",
        "Inactive"
      ]
    },
    "triggers": {
      "type": "string",
      "name": "Triggers",
      "default": "Yes",
      "one-of": [
        "Yes",
        "No"
      ]
    },
    "bpm": {
      "type": "int",
      "name": "Song BPM",
      "description": "Set this to the BPM of the song for beat-synced generation.",
      "default": 120,
      "min": 60,
      "max": 240
    }
  },
  "gd": {
    "win": "*",
    "mac": "*",
    "android": "2.2081",
    "ios": "*"
  }
}
